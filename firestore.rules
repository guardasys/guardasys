rules_version = '2';

// ============================================================================
// REGLAS DE FIRESTORE — TOKU Importados, Sistema de Guarda de Volúmenes
// ============================================================================
// Propuesta inicial (v0.1) basada en el rol guardado en usuarios/{uid}.rol.
// A revisar junto con el tema "usuarios y permisos" — esto es un punto de
// partida razonable para poder probar el módulo de Nueva Guarda, no la
// versión final de permisos por pantalla/acción.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return autenticado() ? datosUsuario().rol : null;
    }

    function esOperador() { return rol() in ["operador", "supervisor", "administrador"]; }
    function esSupervisor() { return rol() in ["supervisor", "administrador"]; }
    function esAdministrador() { return rol() == "administrador"; }

    // -- autoregistro público de clientes (registro-cliente.html, QR sin
    // login) — el alta pública queda restringida a EXACTAMENTE estos 6
    // campos, con validación de tipo/valores/longitud. No permite editar
    // ni borrar; un cliente ya existente nunca se toca por esta vía.
    //
    // Riesgo aceptado (decisión explícita, ver CHANGELOG): la lectura de
    // /clientes queda abierta a cualquiera sin login, para que la página
    // pueda avisar "ya estás registrado" antes de crear un duplicado. Esto
    // significa que alguien que llegue a la URL pública (no solo por el
    // QR del local) podría consultar nombre/teléfono si prueba números de
    // documento al azar. Se aceptó este trade-off por simplicidad; si el
    // volumen de clientes o el riesgo percibido crece, conviene revisar
    // esto (ver nota técnica en CHANGELOG v0.10.0).
    function esCreacionPublicaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(["tipoDocumento", "numeroDocumento", "nombreCompleto", "telefono", "origenRegistro", "creadoEn"])
        && d.tipoDocumento in ["CI", "DNI", "CPF", "Pasaporte", "Otro"]
        && d.numeroDocumento is string && d.numeroDocumento.size() > 0 && d.numeroDocumento.size() <= 30
        && d.nombreCompleto is string && d.nombreCompleto.size() > 0 && d.nombreCompleto.size() <= 150
        && d.telefono is string && d.telefono.size() > 0 && d.telefono.size() <= 30
        && d.origenRegistro == "autoregistro_qr"
        && d.creadoEn == request.time;
    }

    // -- usuarios: cada quien lee su propio doc; solo admin gestiona todos --
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdministrador());
      allow write: if esAdministrador();
    }

    // -- catálogos de configuración: lectura para operar, escritura admin --
    match /puntosGuarda/{id} {
      allow read: if esOperador();
      allow write: if esAdministrador();
    }
    match /terminales/{id} {
      allow read: if esOperador();
      allow write: if esAdministrador();
    }
    match /impresoras/{id} {
      allow read: if esOperador();
      allow write: if esAdministrador();
    }
    match /ubicacionesFisicas/{id} {
      allow read: if esOperador();
      allow write: if esSupervisor();
    }

    // -- operación diaria --
    match /clientes/{id} {
      // Lectura abierta a cualquiera (sin login) — ver nota de riesgo
      // aceptado más arriba, en esCreacionPublicaValida().
      allow read: if true;
      // Alta: personal logueado puede cargar cualquier campo; el
      // autoregistro público solo puede crear con el set de campos
      // validado (nunca editar uno que ya existe).
      allow create: if esOperador() || esCreacionPublicaValida();
      allow update: if esOperador();
      allow delete: if false; // nunca se borra, solo se marca/actualiza
    }

    match /operaciones/{id} {
      allow read, create: if esOperador();
      // cerrar/editar una operación (devolución) — operador para el flujo
      // normal; incidencias/entregas especiales las autoriza un supervisor
      // (se afina en el tema "usuarios y permisos")
      allow update: if esOperador();
      allow delete: if false;
    }

    match /contadores/{id} {
      allow read: if esOperador();
      allow write: if esOperador(); // se escribe dentro de la transacción de ticket
    }

    match /incidencias/{id} {
      allow read: if esOperador();
      allow create: if esOperador();
      allow update: if esSupervisor(); // autorizar/resolver
    }

    // -- auditoría: solo inserción, nadie edita ni borra --
    match /auditoria/{id} {
      allow read: if esSupervisor();
      allow create: if esOperador();
      allow update, delete: if false;
    }
  }
}
